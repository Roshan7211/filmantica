{
  "name": "filmantica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import.mjs",
    "import:dry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import.mjs --dry --rows 50 --pages 1",
    "seed": "node scripts/seed.mjs",
    "review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/review.mjs",
    "test:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-import.mjs",
    "import:discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs",
    "probe:watchmode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs --probe",
    "probe:regions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs --regions --limit 15",
    "test:quality": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-quality.mjs",
    "test:triage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-triage.mjs",
    "readjudicate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/readjudicate.mjs",
    "test:policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-policy.mjs",
    "test:film": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-is-film.mjs",
    "test:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-site.mjs",
    "import:free": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs --free",
    "approve:expired": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/approve-expired.mjs",
    "approve:territory": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/approve-territory.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}