{
  "name": "filmantica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "import:discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs",
    "probe:watchmode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs --probe",
    "probe:regions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs --regions --limit 15",
    "import:free": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-discovery.mjs --free",
    "enrich": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/enrich-discovery.mjs",
    "test:youtube": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-youtube.mjs",
    "test:paginate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-paginate.mjs",
    "test:all": "for t in site youtube paginate credits watchmode; do npm run test:$t --silent; done",
    "test:credits": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-credits.mjs",
    "build:only": "next build",
    "refresh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/refresh-availability.mjs",
    "test:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-site.mjs",
    "test:watchmode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-watchmode.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}